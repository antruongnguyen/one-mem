{
  "name": "one-mem",
  "version": "0.0.0",
  "private": true,
  "description": "Independent TypeScript memory system inspired by Zero-Mem.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22",
    "bun": ">=1.4"
  },
  "packageManager": "bun@1.4.4",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:build": "bun run build && tsc -p tsconfig.test.json",
    "test:node": "node scripts/run-tests.mjs",
    "test:bun": "bun scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "sqlite-vec": "0.1.9"
  }
}
